{
  "name": "vollmedcy",
  "version": "1.0.0",
  "description": "Automação de testes web e API da aplicação Vollmed com Cypress.",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:open:tablet": "cypress open --config viewportWidth=768,viewportHeight=1024",
    "lint": "eslint cypress/**/*.js cypress.config.js",
    "lint:fix": "eslint cypress/**/*.js cypress.config.js --fix",
    "test": "cypress run",
    "test:browser:edge": "cypress run --browser edge",
    "test:tablet": "cypress run --config viewportWidth=768,viewportHeight=1024"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "cypress": "^13.7.2",
    "mochawesome": "^7.1.3",
    "eslint": "^8.57.0",
    "eslint-plugin-cypress": "^2.15.1"
  },
  "dependencies": {
    "cypress-plugin-api": "^2.11.1"
  }
}